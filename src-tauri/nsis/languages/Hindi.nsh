LangString addOrReinstall ${LANG_HINDI} "घटक जोड़ें या फिर इंस्टॉल करें"
LangString alreadyInstalled ${LANG_HINDI} "पहले से इंस्टॉल है"
LangString alreadyInstalledLong ${LANG_HINDI} "${PRODUCTNAME} ${VERSION} पहले से इंस्टॉल है। कार्रवाई चुनें और आगे पर क्लिक करें।"
LangString appRunning ${LANG_HINDI} "{{product_name}} चल रहा है। इसे बंद करके फिर कोशिश करें।"
LangString appRunningOkKill ${LANG_HINDI} "{{product_name}} चल रहा है।$\nइसे बंद करने के लिए ठीक पर क्लिक करें।"
LangString chooseMaintenanceOption ${LANG_HINDI} "रखरखाव की कार्रवाई चुनें।"
LangString choowHowToInstall ${LANG_HINDI} "${PRODUCTNAME} इंस्टॉल करने का तरीका चुनें।"
LangString createDesktop ${LANG_HINDI} "डेस्कटॉप शॉर्टकट बनाएँ"
LangString dontUninstall ${LANG_HINDI} "अनइंस्टॉल न करें"
LangString dontUninstallDowngrade ${LANG_HINDI} "अनइंस्टॉल न करें (पुराना संस्करण इंस्टॉल करने से पहले मौजूदा संस्करण हटाना आवश्यक है)"
LangString failedToKillApp ${LANG_HINDI} "{{product_name}} बंद नहीं हो सका। इसे बंद करके फिर कोशिश करें।"
LangString installingWebview2 ${LANG_HINDI} "WebView2 इंस्टॉल हो रहा है..."
LangString newerVersionInstalled ${LANG_HINDI} "${PRODUCTNAME} का नया संस्करण पहले से इंस्टॉल है। पुराना संस्करण इंस्टॉल करना अनुशंसित नहीं है। पहले मौजूदा संस्करण हटाएँ। कार्रवाई चुनें और आगे पर क्लिक करें।"
LangString older ${LANG_HINDI} "पुराना"
LangString olderOrUnknownVersionInstalled ${LANG_HINDI} "${PRODUCTNAME} संस्करण $R4 पहले से इंस्टॉल है। पहले मौजूदा संस्करण हटाने की सलाह दी जाती है। कार्रवाई चुनें और आगे पर क्लिक करें।"
LangString silentDowngrades ${LANG_HINDI} "शांत मोड में पुराने संस्करण पर वापस जाना समर्थित नहीं है। सामान्य इंस्टॉलर का उपयोग करें।$\n"
LangString unableToUninstall ${LANG_HINDI} "अनइंस्टॉल नहीं हो सका।"
LangString uninstallApp ${LANG_HINDI} "${PRODUCTNAME} अनइंस्टॉल करें"
LangString uninstallBeforeInstalling ${LANG_HINDI} "इंस्टॉल करने से पहले अनइंस्टॉल करें"
LangString unknown ${LANG_HINDI} "अज्ञात"
LangString webview2AbortError ${LANG_HINDI} "WebView2 इंस्टॉल नहीं हो सका। ऐप को चलने के लिए इसकी आवश्यकता है। इंस्टॉलर फिर चलाएँ।"
LangString webview2DownloadError ${LANG_HINDI} "WebView2 डाउनलोड नहीं हो सका: $0"
LangString webview2DownloadSuccess ${LANG_HINDI} "WebView2 इंस्टॉलर डाउनलोड हो गया"
LangString webview2Downloading ${LANG_HINDI} "WebView2 इंस्टॉलर डाउनलोड हो रहा है..."
LangString webview2InstallError ${LANG_HINDI} "WebView2 इंस्टॉल नहीं हो सका। निकास कोड: $1"
LangString webview2InstallSuccess ${LANG_HINDI} "WebView2 इंस्टॉल हो गया"
LangString deleteAppData ${LANG_HINDI} "ऐप डेटा हटाएँ"
